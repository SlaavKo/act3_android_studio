<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/back">


        <TextView
            android:layout_width="match_parent"
            android:id="@+id/inici"
            android:layout_height="wrap_content"
            android:text="@string/b_amp_o_bmi_calculator"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="@color/text"
            app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/seleccio_home"
        app:layout_constraintEnd_toStartOf="@id/seleccio_dona"
        app:layout_constraintTop_toBottomOf="@+id/inici"
        app:layout_constraintStart_toStartOf="parent"
        app:cardBackgroundColor="@color/cardBack">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/home"
                android:src="@drawable/baseline_male_24">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:text="@string/home"
                android:textSize="24sp"
                android:textColor="@color/subText"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/seleccio_dona"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/seleccio_home"
        app:layout_constraintTop_toBottomOf="@+id/inici"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/cardBack">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/dona"
                android:src="@drawable/baseline_female_24">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:text="@string/dona"
                android:textColor="@color/subText"
                android:textSize="24sp"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:elevation="24dp"
        app:cardBackgroundColor="@color/cardBack"
        app:cardCornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/seleccio_home"
        android:id="@+id/height">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/height"
                android:textSize="24sp"
                android:textColor="@color/subText">
            </TextView>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/heightValue"
                    android:text="@string/_170"
                    android:textColor="@color/text"
                    android:textSize="32sp">
                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cm"
                    android:textColor="@color/text"
                    android:textSize="14sp">
                </TextView>

            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/sliderHeight"
                android:layout_weight="0.1"
                android:value="170"
                android:valueTo="250"
                android:valueFrom="40">


            </com.google.android.material.slider.Slider>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:id="@+id/weight"
        app:cardBackgroundColor="@color/cardBack"
        app:layout_constraintEnd_toStartOf="@id/age"
        app:layout_constraintTop_toBottomOf="@id/height"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weight"
                android:textColor="@color/subText"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/weightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_65"
                android:textColor="@color/text"
                android:textSize="52sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/weightLess"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/remove_24px"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />


                <Button
                    android:id="@+id/weightMore"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/add_24px"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/age"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/height"
        app:layout_constraintStart_toEndOf="@id/weight">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/age"
                android:textColor="@color/subText"
                android:textSize="24sp">

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/valueAge"
                android:textSize="52sp"
                android:textColor="@color/text"
                android:text="@string/_19">
            </TextView>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/lessAge"
                    app:icon="@drawable/remove_24px"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                    />


                <Button
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/moreAge"
                    app:icon="@drawable/add_24px"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
                    />
            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/req"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/age"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/danger"
        app:layout_constraintBottom_toTopOf="@id/calculate"
        android:text=""
        android:gravity="center"
        android:layout_margin="16dp"
        android:textSize="24sp"/>

    <Button
        android:id="@+id/calculate"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="@string/calculate"
        android:textSize="42sp"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/weight">

    </Button>
